# By default Reload config with shft + cmd + , 
config-file = themes/rosepine 
# Personal readability loads after the theme. A missing file is harmless.
# Generated outside Git by personalize.sh; null/reset keeps the base values below.
config-file = ?~/.config/dotfiles/readability/ghostty.conf
# No `background` here: themes/rosepine sets it (#000000). Ghostty 1.3.1 loads
# config-file includes AFTER the file that declares them, so a background set
# here is dead config — the theme always wins. Same trap as cursor-color below.
background-opacity = 0.75
background-blur = 23
# Helps transparency work with tiling WMs
macos-window-shadow = false

font-family = JetBrainsMono Nerd Font
font-size = 16
font-thicken = true

# Adjust character spacing (disabled — breaks TUI column math in Claude Code)
# adjust-cell-width = -5%

# Enable programming ligatures (==, =>, !=, >=, <=, etc.)
font-feature = +calt
font-feature = +liga
font-feature = +dlig

cursor-style = block
cursor-style-blink = false
# Modern form of the deprecated cursor-invert-fg-bg = true. The old explicit
# cursor-color = #ffff00 was dead config — the rosepine include loads after
# this file and overrode it.
cursor-color = cell-foreground
cursor-text = cell-background

macos-titlebar-style = hidden
macos-option-as-alt = true
mouse-hide-while-typing = true

confirm-close-surface = false
window-decoration = auto
window-padding-x = 10
window-padding-y = 5
window-padding-balance = true

auto-update = check
auto-update-channel = stable

# extras
shell-integration-features = no-cursor 
# copy-on-select disabled - using tmux for clipboard management
# copy-on-select = clipboard

# Disable right-click context menu (default is context-menu)
# Using tmux for clipboard, so right-click paste is more useful
right-click-action = paste

# Custom Keybinds & Config (super represents cmd key on mac)
# For Simple Keybinds
# keybind = super+r=reload_config 
keybind = super+i=inspector:toggle
keybind = super+b>,=toggle_quick_terminal

# Similar Tmux but with Ghostty
# (ctrl b for tmux -> cmb b for ghostty)
keybind = super+b>r=reload_config
keybind = super+b>x=close_surface
# macos-titlebar-style = hidden (line 29) does not merely hide the tab bar, it
# makes native tabs impossible: Ghostty 1.3.1's HiddenTitlebarTerminalWindow
# sets `tabbingMode = .disallowed` ("Disallow tabbing if the titlebar is
# hidden, since that will (should) also hide the tab bar"). So new_tab opens a
# WINDOW and no tab can ever exist. The nine `goto_tab:N` binds that used to
# sit below were dead for that reason and have been removed -- tmux windows are
# the tabbing layer here. Set macos-titlebar-style = tabs to get real tabs back.
keybind = super+b>c=new_tab 
keybind = super+b>n=new_window

# splitting
keybind = super+b>\=new_split:right
keybind = super+b>-=new_split:down
keybind = super+b>e=equalize_splits
# iTerm-style splits (optional - uncomment if you want these)
# keybind = super+d=new_split:right
# keybind = super+shift+d=new_split:down

# split nav (setting this to control will not work if tmux already uses it)
keybind = super+b>h=goto_split:left
keybind = super+b>j=goto_split:bottom
keybind = super+b>k=goto_split:top
keybind = super+b>l=goto_split:right

