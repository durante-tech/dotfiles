<?xml version="1.0" encoding="UTF-8"?>
<!--
  TEMPLATE — rendered to real plist by setup.sh's render_launchagents().
  __USER__ is substituted with the current $USER at install time.
  The rendered file lands at ~/Library/LaunchAgents/<filename>.plist.

  Ambient-light bridge — NOT one of the five time-of-day bd-* schedulers. This
  comment used to be a copy of theirs and was wrong in every particular: there
  is no StartCalendarInterval here and bd-lmu-watch.sh takes no mode argument.

  What it actually is: a long-running KeepAlive poller. It reads BetterDisplay's
  ambient sensor every 60s, buckets the reading with hysteresis (±15%), and
  calls bd-apply.sh only on a bucket TRANSITION. The interval lives inside the
  script rather than in a StartInterval so one process owns the hysteresis state
  across reads — a per-fire launchd job would forget the last bucket and flap.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.lucas.bd-lmu-watch</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__DOTFILES_DIR__/scripts/scripts/bd-lmu-watch.sh</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/bd-lmu-watch.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/bd-lmu-watch.log</string>
</dict>
</plist>
