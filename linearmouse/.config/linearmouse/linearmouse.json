{
  "$schema": "https://schema.linearmouse.app/0.11.2",
  "schemes": [
    {
      "if": {
        "device": {
          "category": "mouse"
        }
      },
      "pointer": {
        "acceleration": 0,
        "speed": 0.3
      },
      "scrolling": {
        "acceleration": {
          "vertical": 1
        },
        "distance": {
          "vertical": 3
        },
        "reverse": {
          "vertical": false
        }
      }
    }
  ]
}