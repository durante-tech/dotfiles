#![enable(implicit_some)]
#![enable(unwrap_newtypes)]
#![enable(unwrap_variant_newtypes)]
(
    address: "localhost:6600",
    password: None,
    enable_config_hot_reload: true,
    theme: "custom",
    volume_step: 5,
    max_fps: 30,
    scrolloff: 0,
    wrap_navigation: false,
    enable_mouse: true,
    status_update_interval_ms: 1000,
    select_current_song_on_change: false,
    album_art: (
        method: Auto,
        max_size_px: (width: 850, height: 850),
        disabled_protocols: ["http://", "https://"],
        vertical_align: Center,
        horizontal_align: Center,
    ),
    keybinds: (
        // rmpc 0.11.0 breaking change: keybinds now MERGE with the shipped
        // defaults unless `clear` is set. Without it the defaults leak back in
        // and fight this map: `5` binds SwitchToTab("Albums"), a tab this config
        // does not define, so pressing it raises "Tab with name 'Albums' does
        // not exist"; the default `gg`/`gt`/`gT` turn our single-key `g` into a
        // mere prefix, so `g` stalls for normal_timeout_ms (1s) before jumping
        // to the top; and `R`/`X` (AddRandom/Shuffle) mutate the queue from keys
        // we never bound.
        clear: true,
        global: {
            "u":       Update, // update music database
            "U":       Rescan,
            ":":       CommandMode,
            ".":       VolumeUp,
            ",":       VolumeDown,
            "s":       Stop,
            "<Tab>":   NextTab,
            "<S-Tab>": PreviousTab,
            "1":       SwitchToTab("Queue"),
            "2":       SwitchToTab("Playlists"),
            "3":       SwitchToTab("Library"),
            "4":       SwitchToTab("Artists"),
            "F":       SwitchToTab("Search"),
            "q":       Quit,
            ">":       NextTrack,
            "<":       PreviousTrack,
            "f":       SeekForward,
            "b":       SeekBack,
            "p":       TogglePause,
            "z":       ToggleRepeat,
            "x":       ToggleRandom,
            "c":       ToggleConsume,
            "v":       ToggleSingle,
            "?":       ShowHelp,
            "I":       ShowCurrentSongInfo,
            "O":       ShowOutputs,
            "P":       ShowDecoders,
        },
        navigation: { // Playlists pane
            "k":         Up,
            "j":         Down,
            "h":         Left,
            "l":         Right,
            "<Up>":      Up,
            "<Down>":    Down,
            "<Left>":    Left,
            "<Right>":   Right,
            "<C-k>":     PaneUp,
            "<C-j>":     PaneDown,
            "<C-h>":     PaneLeft,
            "<C-l>":     PaneRight,
            "<C-u>":     UpHalf,
            "<C-d>":     DownHalf,
            "N":         PreviousResult,
            "a":         Add, // add song to queue pane
            "A":         AddAll,
            "r":         Rename,
            "n":         NextResult,
            "g":         Top,
            "<Space>":   Select,
            "<C-Space>": InvertSelection,
            "G":         Bottom,
            "<CR>":      Confirm,
            "i":         FocusInput,
            "/":         EnterSearch,
            "<C-c>":     Close,
            "<Esc>":     Close,
            "J":         MoveDown, // move song up in playlist
            "K":         MoveUp, // move song down in playlist
            "D":         Delete,  // delete a song from playlist
            // Successors to the queue-scope AddToPlaylist/ShowInfo/Save binds
            // deleted above: rmpc 0.11.0 converts those three to
            // QueueActions::Unused, which the queue pane matches with an empty
            // arm, so they were silent no-ops. These navigation-scope
            // CommonActions ARE implemented by the queue pane; ContextMenu is
            // where playlist operations on a queue entry moved.
            "oi":        ShowInfo,
            "<C-s>":     Save(kind: Modal(all: false, duplicates_strategy: Ask)),
            "<C-z>":     ContextMenu(),
        },
        queue: { // queue pane
            "D":       DeleteAll,
            "<CR>":    Play,
            "d":       Delete, // delete song from queue
            "C":       JumpToCurrent,
        },
    ),
    // Customize Search Tab
    search: (
        case_sensitive: false,
        mode: Contains,
        tags: [
            (value: "any",         label: "Any Tag"),
            (value: "title",       label: "Title"),
            (value: "album",       label: "Album"),
            (value: "artist",      label: "Artist"),
            (value: "albumartist", label: "Feat."),
            (value: "filename",    label: "Filename"),
            (value: "genre",       label: "Genre"),
        ],
    ),
    artists: (
        album_display_mode: SplitByDate,
        album_sort_by: Date,
    ),
    // Customize tabs here
    tabs: [
        (
            name: "Queue",
            pane: Split(
                direction: Horizontal,
                panes: [
                    // rmpc 0.11.0 removed the theme key `show_song_table_header`
                    // (CHANGELOG: "The queue header is now in a separate
                    // `QueueHeader` pane"), so the Title/Artist/Duration labels
                    // from song_table_format render only if this pane exists.
                    // It also carries 0.11.0's click-to-sort affordance.
                    (size: "75%", pane: Split(
                        direction: Vertical,
                        panes: [
                            (size: "1", pane: Pane(QueueHeader())),
                            (size: "100%", pane: Pane(Queue)),
                        ],
                    )),
                    (size: "25%",  
                            pane: Split(
                                direction: Vertical,
                                panes: [
                                    (
                                            size: "75%",
                                            borders: "NONE",
                                            pane: Pane(AlbumArt),
                                    ),
                                ],
                            ),
                    ),  
                ],
            ),
        ),
        (
            name: "Playlists",
            pane: Split(
                direction: Horizontal,
                panes: [(size: "100%", borders: "ALL", pane: Pane(Playlists))],
            ),
        ),
        (
            name: "Library",
            pane: Pane(Directories),
        ),
        (
            name: "Artists",
            pane: Split(
                direction: Horizontal,
                panes: [(size: "100%", borders: "ALL", pane: Pane(Artists))],
            ),
        ),
        (
            name: "Search",
            pane: Split(
                direction: Horizontal,
                panes: [(size: "100%", borders: "ALL", pane: Pane(Search))],
            ),
        ),
    ],
)
