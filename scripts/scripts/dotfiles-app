#!/usr/bin/env bash
# Launch a preferred app by role. --new preserves AeroSpace's new-terminal action.
set -eu
[ -f "$HOME/.config/dotfiles/personal.env" ] && source "$HOME/.config/dotfiles/personal.env"
DOTFILES_DIR="${DOTFILES_DIR:-$HOME/dotfiles}"
export DOTFILES_DIR DOTFILES_USER_CONFIG_DIR
exec python3 -B "$DOTFILES_DIR/scripts/scripts/lib/preferences-cli.py" launch-app "$@"
