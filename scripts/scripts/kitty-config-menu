#!/usr/bin/env bash

# kitty-config-menu - FZF config file picker (replaces tmux display-menu)

# A label list plus a case, not `declare -A`: `env bash` is macOS bash 3.2,
# where associative arrays do not exist and this script died before the picker.
labels=(.zprofile .zshrc kitty.conf nvim tmux.conf)

selected=$(printf "%s\n" "${labels[@]}" | fzf --prompt="Config> " --border --reverse)

case "$selected" in
    .zshrc)     target="$HOME/.zshrc" ;;
    .zprofile)  target="$HOME/.zprofile" ;;
    kitty.conf) target="$HOME/.config/kitty/kitty.conf" ;;
    nvim)       target="$HOME/.config/nvim" ;;
    tmux.conf)  target="$HOME/.config/tmux/tmux.conf" ;;
    *)          exit 0 ;;
esac

if [[ -d "$target" ]]; then
    cd "$target" && nvim .
else
    nvim "$target"
fi
