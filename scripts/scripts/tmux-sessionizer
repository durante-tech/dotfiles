#!/usr/bin/env bash
# One canonical directory owns one session. Existing sessions are never renamed.
set -u
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=scripts/scripts/lib/sessionizer.sh
source "$SCRIPT_DIR/lib/sessionizer.sh"

tmux_value() {
    local value
    value="$(tmux "$@" && printf '/')" || return 1
    value="${value%/}"
    TMUX_VALUE="${value%$'\n'}"
}

owned_session() {
    local name="$1" path="$2"
    tmux_value show-option -qv -t "=$name" @dotfiles_project_path || return 1
    if [[ -n "$TMUX_VALUE" ]]; then
        [[ "$TMUX_VALUE" == "$path" ]]
    else
        tmux_value display-message -p -t "=$name" '#{session_path}' || return 1
        sessionizer_canonical "$TMUX_VALUE" && [[ "$SESSIONIZER_CANONICAL" == "$path" ]]
    fi
}

hydrate() {
    local name="$1" directory="$2" hook='' quoted
    if [[ -f "$directory/.tmux-sessionizer" ]]; then hook="$directory/.tmux-sessionizer"
    elif [[ -f "$HOME/.tmux-sessionizer" ]]; then hook="$HOME/.tmux-sessionizer"; fi
    [[ -n "$hook" ]] || return 0
    printf -v quoted '%q' "$hook"
    tmux send-keys -t "=$name:" -l "source $quoted" && tmux send-keys -t "=$name:" Enter
}

command -v tmux >/dev/null 2>&1 || { echo 'tmux is missing.' >&2; exit 127; }
case $# in
    0)
        if sessionizer_select; then selected="$SESSIONIZER_SELECTED"
        else rc=$?; [[ "$rc" -eq 1 ]] && exit 0; exit "$rc"; fi ;;
    1) selected="$1" ;;
    *) echo 'Usage: tmux-sessionizer [directory]' >&2; exit 2 ;;
esac
sessionizer_canonical "$selected" || { echo 'Selected project directory is unavailable.' >&2; exit 1; }
project="$SESSIONIZER_CANONICAL"
sessionizer_label "$project"
sessionizer_digest "$project" || exit 1
session="${SESSIONIZER_LABEL}--${SESSIONIZER_DIGEST}"
legacy="${project##*/}"
legacy="${legacy//./_}"
created=false

if tmux has-session -t "=$session" 2>/dev/null; then
    owned_session "$session" "$project" || { echo 'Session identity collision or mismatched project owner.' >&2; exit 1; }
elif [[ -n "$legacy" ]] && tmux has-session -t "=$legacy" 2>/dev/null && owned_session "$legacy" "$project"; then
    session="$legacy"
else
    if tmux new-session -d -s "$session" -c "$project"; then
        created=true
    else
        # A concurrent picker may have created the same session; verify its path.
        owned_session "$session" "$project" || exit 1
    fi
fi
tmux set-option -t "=$session" @dotfiles_project_path "$project" || exit 1
if "$created"; then hydrate "$session" "$project" || exit 1; fi
if [[ -n "${TMUX:-}" ]]; then
    tmux switch-client -t "=$session"
else
    tmux attach-session -t "=$session"
fi
