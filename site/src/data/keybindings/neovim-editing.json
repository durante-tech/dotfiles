{
  "id": "neovim-editing",
  "title": "Neovim Text Objects & Editing",
  "description": "Operators, text objects, surround, and advanced editing",
  "drills": [
    {
      "keys": "ciw",
      "action": "Change inner word",
      "context": "Normal mode",
      "category": "text-object",
      "difficulty": 2,
      "mnemonic": "change inside word",
      "sequence": [
        "c",
        "i",
        "w"
      ]
    },
    {
      "keys": "ci\"",
      "action": "Change inside double quotes",
      "context": "Normal mode",
      "category": "text-object",
      "difficulty": 2,
      "mnemonic": "change inside quotes",
      "sequence": [
        "c",
        "i",
        "\""
      ]
    },
    {
      "keys": "ci(",
      "action": "Change inside parentheses",
      "context": "Normal mode",
      "category": "text-object",
      "difficulty": 2,
      "mnemonic": "change inside parens",
      "sequence": [
        "c",
        "i",
        "("
      ]
    },
    {
      "keys": "di{",
      "action": "Delete inside curly braces",
      "context": "Normal mode",
      "category": "text-object",
      "difficulty": 2,
      "mnemonic": "delete inside braces",
      "sequence": [
        "d",
        "i",
        "{"
      ]
    },
    {
      "keys": "da\"",
      "action": "Delete around double quotes (including quotes)",
      "context": "Normal mode",
      "category": "text-object",
      "difficulty": 3,
      "mnemonic": "delete around quotes",
      "sequence": [
        "d",
        "a",
        "\""
      ]
    },
    {
      "keys": "yi{",
      "action": "Yank inside curly braces",
      "context": "Normal mode",
      "category": "text-object",
      "difficulty": 2,
      "mnemonic": "yank inside braces",
      "sequence": [
        "y",
        "i",
        "{"
      ]
    },
    {
      "keys": "viw",
      "action": "Select inner word",
      "context": "Normal mode",
      "category": "text-object",
      "difficulty": 2,
      "mnemonic": "visual inner word",
      "sequence": [
        "v",
        "i",
        "w"
      ]
    },
    {
      "keys": "vip",
      "action": "Select inner paragraph",
      "context": "Normal mode",
      "category": "text-object",
      "difficulty": 2,
      "mnemonic": "visual inner paragraph",
      "sequence": [
        "v",
        "i",
        "p"
      ]
    },
    {
      "keys": "cit",
      "action": "Change inside HTML tag",
      "context": "Normal mode",
      "category": "text-object",
      "difficulty": 3,
      "mnemonic": "change inside tag",
      "sequence": [
        "c",
        "i",
        "t"
      ]
    },
    {
      "keys": "dw",
      "action": "Delete to next word",
      "context": "Normal mode",
      "category": "operator",
      "difficulty": 1,
      "mnemonic": "delete word",
      "sequence": [
        "d",
        "w"
      ]
    },
    {
      "keys": "d$",
      "action": "Delete to end of line",
      "context": "Normal mode",
      "category": "operator",
      "difficulty": 2,
      "mnemonic": "delete to end",
      "sequence": [
        "d",
        "$"
      ]
    },
    {
      "keys": "D",
      "action": "Delete to end of line (shortcut)",
      "context": "Normal mode",
      "category": "operator",
      "difficulty": 2,
      "mnemonic": "D = d$",
      "sequence": [
        "D"
      ]
    },
    {
      "keys": "C",
      "action": "Change to end of line",
      "context": "Normal mode",
      "category": "operator",
      "difficulty": 2,
      "mnemonic": "C = c$",
      "sequence": [
        "C"
      ]
    },
    {
      "keys": "cc",
      "action": "Change entire line",
      "context": "Normal mode",
      "category": "operator",
      "difficulty": 2,
      "mnemonic": "cc = change line",
      "sequence": [
        "c",
        "c"
      ]
    },
    {
      "keys": ">>",
      "action": "Indent line",
      "context": "Normal mode",
      "category": "operator",
      "difficulty": 2,
      "mnemonic": ">> pushes right",
      "sequence": [
        ">",
        ">"
      ]
    },
    {
      "keys": "<<",
      "action": "Outdent line",
      "context": "Normal mode",
      "category": "operator",
      "difficulty": 2,
      "mnemonic": "<< pushes left",
      "sequence": [
        "<",
        "<"
      ]
    },
    {
      "keys": "J",
      "action": "Join line below with current",
      "context": "Normal mode",
      "category": "editing",
      "difficulty": 2,
      "mnemonic": "J for join",
      "sequence": [
        "J"
      ]
    },
    {
      "keys": "~",
      "action": "Toggle case of character",
      "context": "Normal mode",
      "category": "editing",
      "difficulty": 3,
      "mnemonic": "Tilde swaps case",
      "sequence": [
        "~"
      ]
    },
    {
      "keys": "r",
      "action": "Replace single character",
      "context": "Normal mode",
      "category": "editing",
      "difficulty": 2,
      "mnemonic": "r for replace one",
      "sequence": [
        "r"
      ]
    },
    {
      "keys": "R",
      "action": "Enter Replace mode (overtype)",
      "context": "Normal mode",
      "category": "modes",
      "difficulty": 3,
      "mnemonic": "R for replace mode",
      "sequence": [
        "R"
      ]
    },
    {
      "keys": "saiw\"",
      "action": "Surround word with quotes (mini.surround)",
      "context": "Normal mode",
      "category": "surround",
      "difficulty": 3,
      "mnemonic": "surround add inner word with quotes",
      "sequence": [
        "s",
        "a",
        "i",
        "w",
        "\""
      ]
    },
    {
      "keys": "ds\"",
      "action": "Delete surrounding quotes",
      "context": "Normal mode",
      "category": "surround",
      "difficulty": 3,
      "mnemonic": "delete surround quotes",
      "sequence": [
        "d",
        "s",
        "\""
      ]
    },
    {
      "keys": "sr\"'",
      "action": "Replace surrounding quotes with single quotes",
      "context": "Normal mode",
      "category": "surround",
      "difficulty": 3,
      "mnemonic": "surround replace double with single",
      "sequence": [
        "s",
        "r",
        "\"",
        "'"
