      "category": "picker",
      "difficulty": 1,
      "mnemonic": "leader project files",
      "sequence": [
        "Space",
        "p",
        "f"
      ]
    },
    {
      "keys": "Space ps",
      "action": "Grep search in files",
      "context": "Normal mode",
