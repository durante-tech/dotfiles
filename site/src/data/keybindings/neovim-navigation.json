{
  "id": "neovim-navigation",
  "title": "Neovim Navigation",
  "description": "Flash jumps, Harpoon marks, file pickers, Oil",
  "drills": [
    {
      "keys": "s",
      "action": "Flash jump (type 2 chars to jump)",
      "context": "Normal mode",
      "category": "flash",
      "difficulty": 2,
      "mnemonic": "s for sneak/search",
      "sequence": [
        "s"
      ]
    },
    {
      "keys": "S",
      "action": "Treesitter flash (jump to code structures)",
      "context": "Normal mode",
      "category": "flash",
      "difficulty": 3,
      "mnemonic": "Capital S for structure",
      "sequence": [
        "S"
      ]
    },
    {
      "keys": "Space a",
      "action": "Add file to Harpoon",
      "context": "Normal mode",
      "category": "harpoon",
      "difficulty": 2,
      "mnemonic": "leader a for add",
      "sequence": [
        "Space",
        "a"
      ]
    },
    {
      "keys": "Ctrl+e",
      "action": "Toggle Harpoon quick menu",
      "context": "Normal mode",
      "category": "harpoon",
      "difficulty": 2,
      "mnemonic": "Ctrl+e for explorer",
      "sequence": [
        "Ctrl+e"
      ]
    },
    {
      "keys": "Ctrl+y",
      "action": "Jump to Harpoon mark 1",
      "context": "Normal mode",
      "category": "harpoon",
      "difficulty": 2,
      "mnemonic": "First mark",
      "sequence": [
        "Ctrl+y"
      ]
    },
    {
