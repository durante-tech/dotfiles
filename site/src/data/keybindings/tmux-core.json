{
  "id": "tmux-core",
  "title": "Tmux Core",
  "description": "Sessions, windows, panes, and copy mode",
  "drills": [
    {
      "keys": "Ctrl+b |",
      "action": "Split pane horizontally",
      "context": "Tmux",
      "category": "panes",
      "difficulty": 1,
      "mnemonic": "Pipe splits vertically (visually)",
      "sequence": [
        "Ctrl+b",
        "|"
      ]
    },
    {
      "keys": "Ctrl+b -",
      "action": "Split pane vertically",
      "context": "Tmux",
      "category": "panes",
      "difficulty": 1,
      "mnemonic": "Dash splits horizontally",
      "sequence": [
        "Ctrl+b",
        "-"
      ]
    },
    {
      "keys": "Ctrl+b m",
      "action": "Maximize/restore pane (zoom)",
      "context": "Tmux",
      "category": "panes",
      "difficulty": 2,
      "mnemonic": "m for maximize",
      "sequence": [
        "Ctrl+b",
        "m"
      ]
    },
    {
      "keys": "Ctrl+b D",
      "action": "Detach from session",
      "context": "Tmux",
      "category": "session",
      "difficulty": 2,
      "mnemonic": "D for detach",
      "sequence": [
        "Ctrl+b",
        "D"
      ]
    },
    {
      "keys": "Ctrl+b f",
      "action": "Tmux sessionizer (FZF picker)",
      "context": "Tmux",
      "category": "session",
      "difficulty": 2,
      "mnemonic": "f for find session",
      "sequence": [
        "Ctrl+b",
        "f"
      ]
    },
    {
      "keys": "Ctrl+b n",
      "action": "New session with name",
      "context": "Tmux",
      "category": "session",
      "difficulty": 2,
      "mnemonic": "n for new",
      "sequence": [
        "Ctrl+b",
        "n"
      ]
    },
    {
      "keys": "Ctrl+b o",
      "action": "SessionX session switcher",
      "context": "Tmux",
      "category": "session",
      "difficulty": 2,
      "mnemonic": "o for open sessions",
      "sequence": [
        "Ctrl+b",
        "o"
      ]
    },
    {
      "keys": "Ctrl+b v",
      "action": "Enter copy mode",
      "context": "Tmux",
      "category": "copy",
      "difficulty": 2,
      "mnemonic": "v for visual (like vim)",
      "sequence": [
        "Ctrl+b",
        "v"
      ]
    },
    {
      "keys": "Ctrl+b r",
      "action": "Reload tmux config",
      "context": "Tmux",
      "category": "config",
      "difficulty": 1,
      "mnemonic": "r for reload",
      "sequence": [
        "Ctrl+b",
        "r"
      ]
    },
    {
      "keys": "Ctrl+b Ctrl+g",
      "action": "Open lazygit (floating)",
      "context": "Tmux",
      "category": "floating",
      "difficulty": 2,
      "mnemonic": "g for git",
      "sequence": [
        "Ctrl+b",
        "Ctrl+g"
      ]
    },
    {
      "keys": "Ctrl+b Ctrl+y",
      "action": "Open Yazi (floating)",
      "context": "Tmux",
      "category": "floating",
      "difficulty": 2,
      "mnemonic": "y for yazi",
      "sequence": [
        "Ctrl+b",
        "Ctrl+y"
      ]
    },
    {
      "keys": "Ctrl+b Ctrl+t",
      "action": "Quick terminal (floating)",
      "context": "Tmux",
      "category": "floating",
      "difficulty": 2,
      "mnemonic": "t for terminal",
      "sequence": [
        "Ctrl+b",
        "Ctrl+t"
      ]
    },
    {
      "keys": "Ctrl+b H",
      "action": "Resize pane left",
      "context": "Tmux",
      "category": "panes",
      "difficulty": 3,
      "mnemonic": "vim-style hjkl resize",
      "sequence": [
        "Ctrl+b",
        "H"
      ]
    },
    {
      "keys": "Ctrl+b L",
      "action": "Resize pane right",
      "context": "Tmux",
      "category": "panes",
      "difficulty": 3,
      "mnemonic": "vim-style hjkl resize",
      "sequence": [
        "Ctrl+b",
        "L"
      ]
    },
    {
      "keys": "Ctrl+b Ctrl+k",
      "action": "Clear pane (reset terminal)",
      "context": "Tmux",
      "category": "panes",
      "difficulty": 3,
      "mnemonic": "k for kill/clear",
      "sequence": [
        "Ctrl+b",
        "Ctrl+k"
      ]
    }
  ]
}
