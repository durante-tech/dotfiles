# w3m keymap - Vi-like keybindings
# Following the pattern of other tools in this dotfiles setup

# Navigation (vi-style)
keymap j DOWN
keymap k UP
keymap h LEFT
keymap l RIGHT

# Scrolling
keymap C-f NEXT_PAGE
keymap C-b PREV_PAGE
keymap C-d NEXT_HALF_PAGE
keymap C-u PREV_HALF_PAGE
keymap gg BEGIN
keymap G END
keymap 0 LINE_BEGIN
keymap $ LINE_END

# Tabs
keymap t NEW_TAB
keymap T TAB_MENU
keymap C-h PREV_TAB
keymap C-l NEXT_TAB
keymap d CLOSE_TAB

# Links
keymap f MOVE_LIST_MENU
keymap F LIST_MENU
keymap C-g LINE_INFO

# Search
keymap / SEARCH
keymap ? SEARCH_BACK
keymap n SEARCH_NEXT
keymap N SEARCH_PREV

# History
keymap H BACK
keymap L NEXT
keymap C-o BACK
# C-h is rebound to PREV_TAB above, which took away w3m's default HISTORY key.
# `save_hist 1` keeps writing ~/.w3m/history every session, so without this the
# history panel is collected and reachable from no key at all. ESC-h is unbound
# in w3m's defaults and in this file.
keymap ESC-h HISTORY

# Other
keymap r RELOAD
keymap o GOTO
keymap O TAB_GOTO
keymap B BACK
keymap u GOTO
keymap U TAB_GOTO
keymap v VIEW
keymap ` MARK
# `keymap ' MARK_MID` was here and did not parse: w3m treats a bare ' as a quote
# character, so the line yielded "line 52: invalid command ''" on the status bar
# at EVERY startup, before the page was drawn (removing it clears the message;
# `keymap "'" MARK_MID` also parses). It was not worth keeping quoted either —
# MARK_MID is w3m's Message-ID linkifier, not a vi mark jump. The MARK binding
# above is itself inert while `mark 0` is set in config: main.c's _mark() returns
# with no message when use_mark is 0.
keymap ESC-m MOUSE_TOGGLE
keymap : COMMAND
keymap q QUIT
keymap Q QUIT

# Bookmarks
keymap a ADD_BOOKMARK
keymap b VIEW_BOOKMARK

# External browser (open in default browser)
keymap M EXTERN
keymap ESC-M EXTERN_LINK

# Help (was "keymap ? HELP" — it shadowed SEARCH_BACK; H is history, use :help)
keymap ESC-? HELP
