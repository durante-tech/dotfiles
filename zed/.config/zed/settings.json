// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
	// Zed 1.16 has no `features` key — it is absent from assets/settings/default.json
	// and from SettingsContent, and the root struct has no deny_unknown_fields, so it
	// was ignored in silence and edit predictions ran on the shipped default
	// ("provider": "zed", "mode": "eager"). The live key is edit_predictions.provider.
	"edit_predictions": {
		"provider": "none"
	},
	"vim_mode": true,
	"ui_font_size": 16,
	"buffer_font_size": 16,
	"buffer_font_family": "Codelia Ligatures",
	"current_line_highlight": "none",
	"cursor_shape": "block",
	"tab_size": 4,
	"hard_tabs": true,
	"format_on_save": "off",
	"formatter": "language_server",
	"enable_language_server": true,
	"vertical_scroll_margin": 8,
	"cursor_blink": false,
	// String enum since Zed 1.x (RelativeLineNumbers = disabled | enabled | wrapped,
	// default "disabled"). A bare `true` cannot deserialize; with_fallible_options
	// drops the field instead of erroring, so vim mode silently lost relative numbers.
	"relative_line_numbers": "enabled",
	"ensure_final_newline_on_save": true,
	"remove_trailing_whitespace_on_save": true,
	"tab_bar": {
		"show": false
	},
	"tabs": {
		"git_status": true
	},
	"inlay_hints": {
		// to enable you define it to true in LSP config down below
		"enabled": false
	},
	"scrollbar": {
		"show": "never"
	},
	"toolbar": {
		"breadcrumbs": false,
		"quick_actions": true
	},
	// Move all panel to the right
	"project_panel": {
		"button": true,
		"dock": "right",
		"git_status": true
	},
	"outline_panel": {
		"dock": "right"
	},
	"collaboration_panel": {
		"dock": "left"
	},
	// Move some unnecessary panels to the left
	"notification_panel": {
		"dock": "left"
	},
	// Themes. "Rosé Pine" stopped shipping with Zed in PR #24589 (2025-02-14);
	// assets/themes/ now holds only ayu, gruvbox and one, so the bare name resolves to
	// nothing and Zed falls back to One Dark — breaking the repo-wide rose-pine editor
	// convention on exactly the fresh-machine path. auto_install_extensions is a
	// HashMap<String, bool>, so this merges with the shipped {"html": true} rather
	// than replacing it; extension id rose-pine-theme declares the name verbatim.
	"theme": "Rosé Pine",
	"auto_install_extensions": {
		"rose-pine-theme": true
	},
	"experimental.theme_overrides": {
		// "editor.background": "#121213",
		// "background.appearance": "blurred",
		// "editor.line_number": "#fff",
		// "editor.active_line_number": "#eebebe",
		// "editor.gutter.background": "#121213",
		// "tab_bar.background": "#000",
		// "terminal.background": "#121213",
		// "toolbar.background": "#121213",
		// "tab.active_background": "#121213",
		// "tab.inactive_background": "#121213",
	},
	// LSP Config
	"lsp": {
		"tailwindcss-language-server": {
			"settings": {
				"classAttributes": [
					"class",
					"className",
					"ngClass",
					"styles"
				]
			}
		},
		"gopls": {},
		"rust-analyzer": {}
	},
	"languages": {
		// Refer https://zed.dev/docs/languages/javascript and https://zed.dev/docs/languages/typescript for more info
		"JavaScript": {
			"hard_tabs": true,
			"tab_size": 4,
			"format_on_save": "off",
			// "formatter": "language_server"
			"inlay_hints": {
				"enabled": false
			}
		},
		"TypeScript": {
			// Refer https://github.com/jellydn/ts-inlay-hints for how to setup for Neovim and VSCode
			"inlay_hints": {
				"enabled": false,
				"show_parameter_hints": false,
				"show_other_hints": true,
				"show_type_hints": true //shows type hints right in the line
			},
			"tab_size": 4,
			"hard_tabs": true,
			"format_on_save": "off"
		},
		"JSON": {
			"tab_size": 4,
			"hard_tabs": true,
			"format_on_save": "off"
		},
		"Python": {
			// format_on_save takes the enum only (on | off | modifications |
			// modifications_if_available). Carrying a formatter object here AND in
			// "formatter" makes Zed's m_2025_10_02 migration hit its anyhow::ensure!
			// and return Err, and run_migrations propagates that with `?` — which
			// aborted the ENTIRE settings-migration chain, so the edit_predictions and
			// relative_line_numbers fixes above could never self-heal either. "on" is
			// what that migration itself writes when it rewrites this shape.
			"format_on_save": "on",
			"formatter": {
				"language_server": {
					"name": "ruff"
				}
			},
			"language_servers": [
				"pyright",
				"ruff"
			]
		}
	}
}
